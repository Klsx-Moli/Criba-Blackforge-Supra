{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetryBoxEvidenceContract",
  "description": "Executable evidence contract for CRIBA_VALUE_PILOT_001_RETRYBOX. Validates structured interpretation responses against observation evidence and enforces Anti-Goodhart rules.",
  "type": "object",
  "schema_version": "retrybox.contract.v1",
  "required": [
    "test_case_id",
    "decision",
    "hypothesis",
    "evidence_ids",
    "rationale",
    "requested_evidence",
    "proposed_checks"
  ],
  "properties": {
    "test_case_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": ["propose", "request_more_evidence"]
    },
    "hypothesis": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "requested_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposed_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "propose" } } },
      "then": {
        "properties": {
          "hypothesis": { "type": "string", "minLength": 1 },
          "evidence_ids": { "minItems": 1 },
          "proposed_checks": { "minItems": 1 }
        },
        "required": ["hypothesis", "evidence_ids", "proposed_checks"]
      }
    },
    {
      "if": { "properties": { "decision": { "const": "request_more_evidence" } } },
      "then": {
        "properties": {
          "hypothesis": { "type": "null" },
          "requested_evidence": { "minItems": 1 }
        },
        "required": ["requested_evidence"]
      }
    }
  ]
}
